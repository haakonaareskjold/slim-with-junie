{
  "name": "example/slim-api",
  "description": "A minimal Slim 4 API example (PHP 8.3)",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4",
    "symfony/var-dumper": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public",
    "test": "phpunit --colors=always"
  }
}